# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API (Next.js rewrites in production; Railway URL for local testing)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Capacitor iOS server URL
# Dev (real device, same Wi-Fi): http://192.168.x.x:3000
# Staging/TestFlight: https://your-chailyn-app.vercel.app
# Leave unset for fully offline (bundled static) mode
CAPACITOR_SERVER_URL=http://192.168.x.x:3000
CAPACITOR_CLEARTEXT=true

# Claude API key (only needed if calling /api/recommendations from web)
ANTHROPIC_API_KEY=sk-ant-...
